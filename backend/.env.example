# Local development settings. Copy to .env and adjust as needed.
# Real environment variables always take precedence over this file.

# PostgreSQL (leave POSTGRES_DB unset to use the local SQLite db.sqlite3)
# POSTGRES_DB=vehicle_template_db
# POSTGRES_USER=vehicle_template
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Optional S3-compatible storage - leave empty for local file storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path

# Optional hourly database backups to the configured bucket
DB_BACKUP_ENABLED=false
DB_BACKUP_PREFIX=backups/db/
DB_BACKUP_RETENTION_HOURS=24
DB_BACKUP_INTERVAL_SECONDS=3600
