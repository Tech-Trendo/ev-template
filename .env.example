# Copy to .env on the VPS: cp .env.example .env
# Generate a key with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# Unique Compose project name. Keeps this stack's containers, network and
# volumes separate from any other site running on the same VPS.
COMPOSE_PROJECT_NAME=ev-template

SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=*

# Database (change the password!)
POSTGRES_DB=vehicle_template_db
POSTGRES_USER=vehicle_template
POSTGRES_PASSWORD=replace-with-a-strong-password

# Host port for the dashboard. Pick a free port — the other site on the VPS
# may already own 3000/3001/8080.
HOST_PORT=3001

# Container images used by the GitHub Actions deploy workflow. Leave these
# commented out for local `docker compose up --build`.
# BACKEND_IMAGE=ghcr.io/tech-trendo/ev-template-backend:latest
# FRONTEND_IMAGE=ghcr.io/tech-trendo/ev-template-frontend:latest

# Seed demo data on first boot (set to false for an empty database)
SEED_ON_START=true

# Branding shown in generated documents / API schema
COMPANY_NAME=Vehicle Template
COMPANY_TAGLINE=Commercial Vehicle and Fleet Solutions

# Browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Optional S3-compatible storage — leave blank to use the local media volume
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
