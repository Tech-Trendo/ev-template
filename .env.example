# Copy to .env on the VPS: cp .env.example .env
# Generate a key with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=*

# Database (change the password!)
POSTGRES_DB=vehicle_template_db
POSTGRES_USER=vehicle_template
POSTGRES_PASSWORD=replace-with-a-strong-password

# Where the dashboard is reachable on the host
HOST_PORT=3000

# Seed demo data on first boot (set to false for an empty database)
SEED_ON_START=true

# Branding shown in generated documents / API schema
COMPANY_NAME=Vehicle Template
COMPANY_TAGLINE=Commercial Vehicle and Fleet Solutions

# Browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional S3-compatible storage — leave blank to use the local media volume
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
